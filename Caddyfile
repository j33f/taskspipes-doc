# Serves the prerendered documentation over plain HTTP; TLS is handled by the front proxy.
:80 {
	root * /srv
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		-Server
	}
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
}
